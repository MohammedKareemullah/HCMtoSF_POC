# ---- Already in your .env (same keys as your Python script) ----
# MCP_URL=https://localhost:8000/hypercare-mcp
# MCP_JWT_SECRET=...
# SAP_ASHOST=  SAP_SYSNR=  SAP_CLIENT=  SAP_USER=  SAP_PASSWD=  SAP_LANG=EN
# optional: SAP_HTTP_BASE_URL, SAP_HTTP_CLIENT, SAP_HTTP_USER, SAP_HTTP_PASSWD

# ---- New: server ----
PORT=4000
CORS_ORIGIN=*

# ---- New: Postgres (use DATABASE_URL, or the PG* variables) ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hr_kpi
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=hr_kpi
# PGSSL=false
# Maintenance DB used only to CREATE DATABASE when the target DB does not exist yet
# PG_ADMIN_DATABASE=postgres

# ---- New: SAP fetch tuning ----
# Rows per sap_table_read call (paged with rowSkips)
SAP_PAGE_SIZE=5000
SAP_MAX_PAGES=2000
# How many SAP tables are read in parallel
SAP_FETCH_CONCURRENCY=2
# After a failed auto-refresh, wait this long before trying SAP again (serves last good data meanwhile)
SYNC_RETRY_COOLDOWN_MS=60000

# ---- New: headcount KPI business settings ----
# PA0000-MASSN action codes that count as a "hire"
HIRE_MASSN_CODES=01
# Key field of T500P that holds the personnel area (you said WERKS; standard SAP calls it PERSA)
T500P_WERKS_FIELD=WERKS
# Optional: only count payroll results with these HRPY_RGDIR-SRTZA values (e.g. A). Empty = no filter
PAYROLL_SRTZA_FILTER=
